# ---- Supabase (server: apps/web) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (server only, never in mobile apps) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for each tier. Names are referenced from packages/core/config/tiers.json
STRIPE_PRICE_SIP=price_...
STRIPE_PRICE_REGULAR=price_...
STRIPE_PRICE_DAILY=price_...

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for the weekly payout and nightly jobs (Vercel Cron / GitHub Actions)
CRON_SECRET=change-me
# Optional: send real email through Resend. Without it, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Sippy Brew <hello@sippybrew.example>"
